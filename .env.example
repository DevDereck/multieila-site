# Archivo de ejemplo para variables de entorno (no subir a git)
# SMTP (proveedor SMTP o servicio de correo transaccional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=secretpassword

# A qué correo enviar las solicitudes desde el sitio
TO_EMAIL=recepcion@multieila.com
